# Connexion MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3311
MYSQL_USER=root
MYSQL_PASSWORD=changeme
MYSQL_DATABASE=soutenance

# URL du frontend (pour CORS)
FRONTEND_URL=http://localhost:8080

# Port du serveur backend
PORT=4000

# Clé secrète JWT (obligatoire — générez avec : openssl rand -hex 32)
JWT_SECRET=changeme_generate_with_openssl_rand_hex_32

# Environnement (production active le flag Secure sur le cookie httpOnly)
NODE_ENV=development

# SMTP pour l'envoi réel des OTP (optionnel)
# Si absent, le code OTP s'affiche dans la console du serveur (mode démonstration)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=votre.email@gmail.com
SMTP_PASS=votre_app_password_gmail
SMTP_FROM=noreply@arpce.cg
